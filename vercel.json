{
  "redirects": [
    {
      "source": "/:path(.*)",
      "has": [
        {
          "type": "host",
          "value": "tonconnect-sdk-docs.vercel.app"
        }
      ],
      "destination": "https://docs.ton-connect.io/sdk/:path",
      "permanent": true
    },
    {
      "source": "/:path((?!tonconnect-manifest\\.json$).*)",
      "has": [
        {
          "type": "host",
          "value": "tma-debug.vercel.app"
        }
      ],
      "destination": "https://tma-debug.ton-connect.io/:path",
      "permanent": true
    }
  ]
}
